<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.FormView" t-inherit-mode="extension">
        <!-- Bouton « Modifier » dans la zone des boutons principaux de la barre
             de contrôle, juste avant « Nouveau » (emplacement classique).
             Sur mobile, étant le premier bouton, il reste visible directement. -->
        <xpath expr="//t[@t-set-slot='control-panel-create-button']/button[hasclass('o_form_button_create')]" position="before">
            <button t-if="editButtonEnabled and !model.root.isInEdition"
                    type="button"
                    class="btn btn-primary o_form_button_edit"
                    data-hotkey="a"
                    t-on-click.stop="onFormEditButtonClicked">Edit</button>
        </xpath>

        <!-- Nuage + croix visibles pendant toute la durée de l'édition. -->
        <xpath expr="//FormStatusIndicator" position="attributes">
            <attribute name="showButtonsInEdition">editButtonEnabled</attribute>
        </xpath>
    </t>

</templates>
