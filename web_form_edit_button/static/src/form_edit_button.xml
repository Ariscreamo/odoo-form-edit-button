<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Odoo 20 : les boutons principaux du formulaire (« Nouveau ») sont dans
         le template web.FormView.Buttons. Le bouton « Modifier » est placé
         juste avant « Nouveau » (emplacement classique). Les vues qui ont leur
         propre template de boutons (Ventes, Projet…) en héritent et le
         récupèrent automatiquement. Sur mobile, étant le premier bouton, il
         reste visible directement. -->
    <t t-inherit="web.FormView.Buttons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_form_button_create')]" position="before">
            <button t-if="this.editButtonEnabled and !this.model.root.isInEdition"
                    type="button"
                    class="btn btn-primary o_form_button_edit"
                    data-hotkey="a"
                    t-on-click.stop="this.onFormEditButtonClicked">Edit</button>
        </xpath>
    </t>

</templates>
